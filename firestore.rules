rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDM() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.charId == 'dm';
    }

    function ownsChar(charId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.charId == charId;
    }

    // Characters: anyone signed in can read; DM or owning player can write
    match /characters/{charId} {
      allow read: if isSignedIn();
      allow write: if isDM() || ownsChar(charId);
    }

    // Users: DM can read all; each user can read/write their own doc
    match /users/{uid} {
      allow read: if isDM() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Campaign settings/broadcast: anyone can read; only DM can write
    match /campaign/{doc} {
      allow read: if true;
      allow write: if isDM();
    }

    // Purchases: any signed-in player can read and contribute
    match /purchases/{id} {
      allow read, write: if isSignedIn();
    }

    // Combat: anyone can read (players see combat screen); only DM can write
    match /combat/{doc} {
      allow read: if true;
      allow write: if isDM();
    }
  }
}
