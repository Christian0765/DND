rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }
    match /campaigns/{campaignId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null &&
        (resource.data.dmUid == request.auth.uid ||
         request.auth.uid in resource.data.memberUids);
      allow update: if request.auth != null &&
        (resource.data.dmUid == request.auth.uid ||
         request.auth.uid in resource.data.memberUids ||
         // Allow self-join: user adding only themselves to players + memberUids
         (request.auth.uid in request.resource.data.memberUids &&
          !(request.auth.uid in resource.data.memberUids) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'memberUids'])));

      // {document=**} matches ALL subcollections at any depth:
      // characters/, pendingCharacters/, general_npcs/,
      // lands/, lands/{id}/shops/, lands/{id}/npcs/, lands/{id}/maps/
      match /{document=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.dmUid == request.auth.uid ||
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.memberUids.hasAny([request.auth.uid])
        );
      }
    }
  }
}
