rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /campaigns/{campaignId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /characters/{slot} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null;

        // All subcollections: inventory, weapons, resources, features,
        // spells, preferences, sessionNotes
        match /{subcollection}/{docId} {
          allow read:  if request.auth != null;
          allow write: if request.auth != null;
        }
      }

      match /pendingCharacters/{slot} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null;
      }

      match /rest/{doc} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null;
      }

      match /combat/{doc} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null;
      }

      match /shared/{doc} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null;
      }
    }
  }
}
